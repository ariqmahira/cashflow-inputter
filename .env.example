# Pulled from Vercel, not written by hand:
#   vercel env pull .env.local --yes
#
# Both are compiled into the client bundle and are public by design. The secret and
# service-role keys must never be given a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only, used by the migration scripts. Prefer the non-pooling URL for DDL.
POSTGRES_URL_NON_POOLING=postgres://...

# Optional. Path to the CA from Supabase → Settings → Database → SSL Configuration.
# Without it the database connection is encrypted but the certificate chain is unverified.
# SUPABASE_CA_CERT=/path/to/prod-ca.crt
