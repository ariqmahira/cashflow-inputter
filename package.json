{
  "name": "cashflow-inputter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file=.env.local scripts/db/apply-migrations.mts",
    "start": "next start",
    "android:sync": "next build && cap sync android",
    "android:open": "cap open android",
    "db:link": "tsx --env-file=.env.local scripts/db/link-member.mts"
  },
  "dependencies": {
    "@capacitor-mlkit/document-scanner": "^8.2.1",
    "@capacitor-mlkit/text-recognition": "^8.2.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@electric-sql/pglite": "^0.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pg": "^8.23.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
