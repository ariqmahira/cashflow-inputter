{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "scripts/**/*.mts",
    "supabase/**/*.mts",
    "src/lib/plain-date.ts",
    "vitest.config.ts"
  ]
}
